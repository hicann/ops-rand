<?xml version="1.0" encoding="UTF-8"?>
<config name="ops_rand" copy_type="delivery" src_path="lib/" dst_path="ops_rand" install_type="all" install_mod="550" install_own="$username:$usergroup">
    <package_info>
        <product_name>cann</product_name>
        <chip_name>950</chip_name>
        <func_name>ops-rand</func_name>
        <suffix>run</suffix>
        <install_script>share/info/ops_rand/script/install.sh</install_script>
        <help>share/info/ops_rand/script/help.info</help>
        <cleanup>share/info/ops_rand/script/cleanup.sh</cleanup>
    </package_info>
    <generate_info value="ops_rand_version.h" dst_path="share/info/ops_rand" install_path="$(TARGET_ENV)/include/version" install_mod="440" install_type="devel" generator="version_header">
       <OPS_RAND_VERSION>$(ASCEND_VER)</OPS_RAND_VERSION>
       <OPS_RAND_TIMESTAMP>$(TIMESTAMP_NO)</OPS_RAND_TIMESTAMP>
    </generate_info>
    <generate_info value="scene.info" dst_path="share/info/ops_rand" install_path="share/info/ops_rand" install_mod="440">
        <os>$(OS_NAME)</os>
        <os_version>$(OS_VER)</os_version>
        <arch>$(ARCH)</arch>
    </generate_info>
    <file_info value="ops_rand_script" copy_type="source" src_path="" dst_path="share/info/ops_rand" install_path="share/info/ops_rand">
        <file value="script" entity="true"/>
        <file value="version.info"/>
    </file_info>
    <block_info dependtree="false" dst_path="ops_rand" block_conf_path="ascend">
        <block name="EngineeringCommon"/>
        <block name="EngineeringFiles"/>
        <block name="OpsRand"/>
        <block name="OpsRandInc"/>
    </block_info>
    <dir_info value="ops_rand" install_path="ops_rand" install_type="all">
        <path value="share" install_mod="750"/>
        <path value="share/info" install_mod="750"/>
        <path value="share/info/ops_rand" install_mod="550"/>
        <path value="share/info/ops_rand/script" install_mod="550"/>
    </dir_info>
</config>
